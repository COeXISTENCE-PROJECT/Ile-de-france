    <tag k="artwork_type" v="statue"/>
    <tag k="description" v="Saint-Vincent de Paul représenté à l&apos;accoutumée avec deux enfants. Il s&apos;agit très certainement d&apos;une réplique de la même statue présente dans la cour de l&apos;abbatiale Sainte-Croix de Bouzonville (Moselle, France)."/>
    <tag k="name" v="Saint Vincent de Paul"/>
    <tag k="tourism" v="artwork"/>
  </node>
  <node id="8691171535" version="4" timestamp="2021-05-26T15:23:50Z" lat="48.7308906" lon="2.7623185">
    <tag k="artwork_type" v="statue"/>
    <tag k="description" v="Sainte Thérèse de Lisieux dans ses attributs classiques : en habit de carmélite, avec une croix entourée de roses dans les mains."/>
    <tag k="name" v="Sainte Thérèse de l&apos;Enfant-Jésus"/>
    <tag k="tourism" v="artwork"/>
    <tag k="wikimedia_commons" v="File:Statue_devant_le_château_de_Combreux,_Tournan-en-Brie_-_panoramio.jpg"/>
  </node>
  <node id="8691171536" version="4" timestamp="2021-05-26T15:23:50Z" lat="48.7302085" lon="2.761592">
    <tag k="artwork_type" v="statue"/>
    <tag k="description" v="Vierge couronnée, debout, soutenant l’enfant Jésus, bras ouverts, dans ses mains.&#xA;&#xA;Une statue identique se trouve à l&apos;école Notre-Dame Sainte-Thérèse de Santes, 152 rue Foch, Santes, Nord, France."/>
    <tag k="material" v="metal"/>
    <tag k="name" v="Vierge à l&apos;Enfant"/>
    <tag k="tourism" v="artwork"/>
