  <node id="8725833927" version="4" timestamp="2024-08-04T08:56:38Z" lat="48.7413764" lon="2.7625484">
    <tag k="description" v="Érigé le 31 juillet 1887. Élevé par souscription effectuée dans dix-sept communes des environs de Tournan. Il s&apos;agissait d&apos;un buste en bronze (fondu sous l&apos;occupation en 1941) reposant sur un socle. Seul ce dernier subsiste."/>
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Au Docteur Forgemol. 31 juillet 1887."/>
    <tag k="material" v="concrete"/>
    <tag k="memorial" v="column"/>
    <tag k="name" v="Monument au Docteur Forgemol"/>
    <tag k="short_name" v="Dr Forgemol"/>
    <tag k="source:url" v="https://e-monumen.net/patrimoine-monumental/monument-au-docteur-forgemol-tournan-en-brie/"/>
  </node>
